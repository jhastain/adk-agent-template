GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT={{SERVICE_PREFIX}}-dev-project
GOOGLE_CLOUD_LOCATION=us-central1

# Model - routed through the LLM gateway
AGENT_MODEL_ID=claude-sonnet-4-6

SENTRY_DSN=
SENTRY_ENV=development
LOG_LEVEL=INFO

DD_ENV=local
DD_SERVICE={{AGENT_NAME_LOWER}}

# LLM + MCP gateway. One OpenAI-compatible endpoint serves both; one key for both.
LLM_GATEWAY_URL=https://llm-gateway.example.com/v1
MCP_GATEWAY_URL=https://llm-gateway.example.com/mcp
LLM_GATEWAY_TOKEN=
