        </mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="full" target="ae">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="auth" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="wif" target="full">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="every LLM + MCP call" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ae" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="key read at startup" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="sm" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" value="verifies" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="e2e" target="skel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="The IaC tree IS the configuration: app.hcl takes app_id from its own directory name, env.hcl takes environment from its own, region.hcl derives the region and its short forms. Rename a directory, rename the resources.&#xa;Remote state prefix comes from path_relative_to_include(), so each leaf module gets its own state file with no extra wiring." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=10;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="800" width="1040" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
